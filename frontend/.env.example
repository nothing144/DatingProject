# Example Environment Configuration
# Copy this file to .env and fill in your actual values

# Supabase Configuration - PUBLIC keys (safe for frontend)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Cloudinary Configuration - PUBLIC keys only
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
VITE_CLOUDINARY_API_KEY=your_cloudinary_public_api_key_here

# SECURITY WARNING:
# Never put API_SECRET keys in frontend environment variables!
# Secrets should only be set in:
# 1. Supabase Edge Function secrets (server-side)
# 2. Backend environment variables
# 3. Secure deployment platforms (Netlify secrets, etc.)

# How to get your keys:
# 1. Supabase: Dashboard → Project Settings → API
# 2. Cloudinary: Dashboard → Settings → Account
# 3. See /SECURITY_SETUP.md for detailed instructions